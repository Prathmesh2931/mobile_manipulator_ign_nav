<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="diff_drive">
    <physics name="1ms" type="bullet">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <max_contacts>20</max_contacts>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="ignition-gazebo-magnetometer-system" name="gz::sim::systems::Magnetometer"/>

    <gui>
      <camera name="main_camera">
        <pose>0 2 2 0 0.5 0</pose>
      </camera>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>2</mu>
                <mu2>2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="rover">
      <pose>0 0 0.25 0 0 0</pose>
      <link name="chassis">
        <inertial>
          <mass>10.0</mass>
          <inertia>
            <ixx>0.5</ixx> <ixy>0.0</ixy> <ixz>0.0</ixz>
            <iyy>0.5</iyy> <iyz>0.0</iyz>
            <izz>0.5</izz>
          </inertia>
        </inertial>
        <visual name="chassis_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/base_link.stl</uri>
              <scale>0.01 0.01 0.01</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <visual name="chassis_fallback_visual">
          <geometry>
            <box>
              <size>1.0 0.8 0.1</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.0 0.8 0.0 1</diffuse>
          </material>
        </visual>
        <collision name="chassis_collision">
          <geometry>
            <box>
              <size>1.0 0.8 0.1</size>
            </box>
          </geometry>
        </collision>
        <sensor name="imu_sensor" type="imu">
          <pose>0 0 0 0 0 0</pose>
          <topic>/imu</topic>
          <update_rate>50</update_rate>
        </sensor>
        <sensor name="magnetometer_sensor" type="magnetometer">
          <pose>0 0 0 0 0 0</pose>
          <topic>/magnetometer</topic>
          <update_rate>5</update_rate>
        </sensor>
      </link>

      <link name="front_left_wheel">
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.01</ixx> <ixy>0.0</ixy> <ixz>0.0</ixz>
            <iyy>0.01</iyy> <iyz>0.0</iyz>
            <izz>0.01</izz>
          </inertia>
        </inertial>
        <visual name="front_left_wheel_visual">
          <pose>0 0 0 0 0 1.5708</pose>
          <geometry>
            <mesh>
              <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/wheel_front_left_link.stl</uri>
              <scale>0.01 0.01 0.01</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.2 0.2 0.8 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <collision name="front_left_wheel_collision">
          <pose>0 0 0 0 0 1.5708</pose>
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.1</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>2</mu>
                <mu2>2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <link name="front_right_wheel">
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.01</ixx> <ixy>0.0</ixy> <ixz>0.0</ixz>
            <iyy>0.01</iyy> <iyz>0.0</iyz>
            <izz>0.01</izz>
          </inertia>
        </inertial>
        <visual name="front_right_wheel_visual">
          <pose>0 0 0 0 0 1.5708</pose>
          <geometry>
            <mesh>
              <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/wheel_front_right_link.stl</uri>
              <scale>0.01 0.01 0.01</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.2 0.2 0.8 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <collision name="front_right_wheel_collision">
          <pose>0 0 0 0 0 1.5708</pose>
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.1</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>2</mu>
                <mu2>2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <link name="rear_left_wheel">
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.01</ixx> <ixy>0.0</ixy> <ixz>0.0</ixz>
            <iyy>0.01</iyy> <iyz>0.0</iyz>
            <izz>0.01</izz>
          </inertia>
        </inertial>
        <visual name="rear_left_wheel_visual">
          <pose>0 0 0 0 0 1.5708</pose>
          <geometry>
            <mesh>
              <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/wheel_back_left_link.stl</uri>
              <scale>0.01 0.01 0.01</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.2 0.2 0.8 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <collision name="rear_left_wheel_collision">
          <pose>0 0 0 0 0 1.5708</pose>
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.1</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>2</mu>
                <mu2>2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <link name="rear_right_wheel">
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.01</ixx> <ixy>0.0</ixy> <ixz>0.0</ixz>
            <iyy>0.01</iyy> <iyz>0.0</iyz>
            <izz>0.01</izz>
          </inertia>
        </inertial>
        <visual name="rear_right_wheel_visual">
          <pose>0 0 0 0 0 1.5708</pose>
          <geometry>
            <mesh>
              <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/wheel_back_right_link.stl</uri>
              <scale>0.01 0.01 0.01</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.2 0.2 0.8 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <collision name="rear_right_wheel_collision">
          <pose>0 0 0 0 0 1.5708</pose>
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.1</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>2</mu>
                <mu2>2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>

      <joint name="front_left_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>front_left_wheel</child>
        <pose>0.554283 0.625029 0 0 0 1.57</pose>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>

      <joint name="front_right_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>front_right_wheel</child>
        <pose>0.554282 -0.625029 0 0 0 0</pose>
        <axis>
          <xyz>0 -1 0</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>

      <joint name="rear_left_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>rear_left_wheel</child>
        <pose>-0.957138 0.625029 0 0 0 0</pose>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>

      <joint name="rear_right_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>rear_right_wheel</child>
        <pose>-0.957138 -0.625029 0 0 0 0</pose>
        <axis>
          <xyz>0 -1 0</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>front_left_wheel_joint</left_joint>
        <left_joint>rear_left_wheel_joint</left_joint>
        <right_joint>front_right_wheel_joint</right_joint>
        <right_joint>rear_right_wheel_joint</right_joint>
        <wheel_separation>1.25</wheel_separation>
        <wheel_radius>0.25</wheel_radius>
        <odom_publish_frequency>50</odom_publish_frequency>
        <topic>/rover/cmd_vel</topic>
        <odom_topic>/rover/odometry</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>chassis</child_frame_id>
        <min_linear_velocity>-0.5</min_linear_velocity>
        <max_linear_velocity>0.5</max_linear_velocity>
        <min_angular_velocity>-1.0</min_angular_velocity>
        <max_angular_velocity>1.0</max_angular_velocity>
        <min_linear_acceleration>-1.0</min_linear_acceleration>
        <max_linear_acceleration>1.0</max_linear_acceleration>
        <min_angular_acceleration>-2.0</min_angular_acceleration>
        <max_angular_acceleration>2.0</max_angular_acceleration>
        <publish_odom_tf>true</publish_odom_tf>
        <max_torque>20.0</max_torque>
      </plugin>
    </model>
  </world>
</sdf>