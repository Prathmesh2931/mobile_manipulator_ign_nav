    <link name='imu_link'>
      <pose relative_to='base_link'>-0.032 0 0.068 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
