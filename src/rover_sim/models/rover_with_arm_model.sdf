<?xml version="1.0" ?>
<sdf version="1.7">
  <model name='rover_with_arm'>
    <pose>0 0 0.033 0 0 0</pose>
    
    <!-- Rover Base Components -->
    <link name='base_footprint'>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <link name='base_link'>
      <pose relative_to='base_footprint'>0 0 0.01 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.1</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.1</iyy>
