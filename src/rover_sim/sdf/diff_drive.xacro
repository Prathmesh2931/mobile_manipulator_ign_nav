<?xml version="1.0" ?>
<sdf version="1.9" xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Properties for parameterization -->
  <xacro:property name="model_name" value="vehicle_blue"/>
  <xacro:property name="spawn_x" value="1.0"/>
  <xacro:property name="spawn_y" value="1.0"/>
  <xacro:property name="spawn_z" value="0.325"/>
  <xacro:property name="wheel_radius" value="0.25"/>
  <xacro:property name="wheel_separation" value="1.25"/>
  <xacro:property name="max_torque" value="30.0"/>
  <xacro:property name="friction_mu" value="0.6"/>

  <!-- Wheel Macro -->
  <xacro:macro name="wheel" params="name prefix x y">
    <link name="${prefix}_${name}_wheel">
      <pose>${x} ${y} -0.025 -1.5707 0 0</pose>
      <inertial>
        <mass>2</mass>
        <inertia>
          <ixx>0.0416667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0416667</iyy>
          <iyz>0</iyz>
          <izz>0.025</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>${wheel_radius}</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>${wheel_radius}</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>${friction_mu}</mu>
              <mu2>${friction_mu}</mu2>
              <slip1>0.01</slip1>
              <slip2>0.01</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="${prefix}_${name}_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>${prefix}_${name}_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
        <dynamics>
          <damping>0.1</damping>
        </dynamics>
      </axis>
    </joint>
  </xacro:macro>

  <!-- DiffDrive Plugin Macro -->
  <xacro:macro name="diff_drive_plugin" params="left_joints right_joints wheel_separation wheel_radius max_torque">
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <xacro:insert_block name="left_joints"/>
      <xacro:insert_block name="right_joints"/>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/rover/cmd_vel</topic>
      <odom_topic>/rover/odometry</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>chassis</child_frame_id>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_linear_velocity>0.5</max_linear_velocity>
      <min_angular_velocity>-1.0</min_angular_velocity>
      <max_angular_velocity>1.0</max_angular_velocity>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <publish_odom_tf>true</publish_odom_tf>
      <max_torque>${max_torque}</max_torque>
    </plugin>
  </xacro:macro>

  <!-- PosePublisher Plugin Macro -->
  <xacro:macro name="pose_publisher_plugin">
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>true</publish_link_pose>
      <use_sim_time>true</use_sim_time>
      <update_frequency>10</update_frequency>
    </plugin>
  </xacro:macro>

  <!-- IMU Plugin Macro -->
  <xacro:macro name="imu_plugin" params="link_name">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <pose>0 0 0 0 0 0</pose>
      <topic>/imu/data</topic>
      <update_rate>100</update_rate>
      <imu>
        <linear_acceleration>
          <x_noise>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </x_noise>
          <y_noise>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </y_noise>
          <z_noise>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </z_noise>
        </linear_acceleration>
        <angular_velocity>
          <x_noise>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </x_noise>
          <y_noise>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </y_noise>
          <z_noise>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </z_noise>
        </angular_velocity>
      </imu>
    </sensor>
  </xacro:macro>

  <!-- World Definition -->
  <world name="diff_drive">
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="${model_name}">
      <pose>${spawn_x} ${spawn_y} ${spawn_z} 0 0 0</pose>
      <link name="chassis">
        <pose>-0.151427 0 0.175 0 0 0</pose>
        <inertial>
          <mass>1.14395</mass>
          <inertia>
            <ixx>0.126164</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.416519</iyy>
            <iyz>0</iyz>
            <izz>0.481014</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box>
              <size>2.01142 1 0.568726</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 1.0 1</ambient>
            <diffuse>0.5 0.5 1.0 1</diffuse>
            <specular>0.0 0.0 1.0 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>2.01142 1 0.568726</size>
            </box>
          </geometry>
        </collision>
        <xacro:imu_plugin link_name="chassis"/>
      </link>
      <xacro:wheel name="left" prefix="front" x="0.554283" y="0.625029"/>
      <xacro:wheel name="left" prefix="rear" x="-0.957138" y="0.625029"/>
      <xacro:wheel name="right" prefix="front" x="0.554282" y="-0.625029"/>
      <xacro:wheel name="right" prefix="rear" x="-0.957138" y="-0.625029"/>
      <xacro:pose_publisher_plugin/>
      <xacro:diff_drive_plugin
        left_joints="front_left_wheel_joint rear_left_wheel_joint"
        right_joints="front_right_wheel_joint rear_right_wheel_joint"
        wheel_separation="${wheel_separation}"
        wheel_radius="${wheel_radius}"
        max_torque="${max_torque}"/>
    </model>
  </world>
</sdf>