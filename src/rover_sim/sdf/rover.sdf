<?xml version="1.0" ?>
<sdf version="1.9">
    <world name="diff_drive">
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
     <plugin
      filename="ignition-gazebo-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin
      filename="ignition-gazebo-magnetometer-system"
      name="gz::sim::systems::Magnetometer">
    </plugin>


    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>
  <model name="rover">
    <!-- Chassis (base_link) -->
    <link name="chassis">
    <pose>-0.0 0.0 0.0  0 0 0</pose>
      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.1</ixx> <ixy>0.0</ixy> <ixz>0.0</ixz>
          <iyy>0.1</iyy> <iyz>0.0</iyz>
          <izz>0.1</izz>
        </inertia>
      </inertial>
      <visual name="chassis_visual">
      <origin xyz="0 0 1.0" rpy="0 0 0" />
        <geometry>
          <mesh>
            <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/base_link.stl</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name="chassis_collision">
        <geometry>
          <mesh>
            <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/base_link.stl</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
      </collision>
      <!-- IMU Sensor -->
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <topic>/imu</topic>
        <update_rate>100</update_rate>
      </sensor>
      <!-- Magnetometer Sensor -->
      <sensor name="magnetometer_sensor" type="magnetometer">
        <pose>0 0 0 0 0 0</pose>
        <topic>/magnetometer</topic>
        <update_rate>10</update_rate>
      </sensor>
    </link>

    <!-- Front Left Wheel -->
    <link name="front_left_wheel">
      <pose>-0.0 0.0 0.0  0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.01</ixx> <ixy>0.0</ixy> <ixz>0.0</ixz>
          <iyy>0.01</iyy> <iyz>0.0</iyz>
          <izz>0.01</izz>
        </inertia>
      </inertial>
      <visual name="front_left_wheel_visual">
        <origin xyz="0 0 4" rpy="0 0 0" />
        <geometry>
          <mesh>
           <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/wheel_front_left_link.stl</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="front_left_wheel_collision">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh>
            <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/wheel_front_left_link.stl</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- Rear Left Wheel -->
    <link name="rear_left_wheel">
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.01</ixx> <ixy>0.0</ixy> <ixz>0.0</ixz>
          <iyy>0.01</iyy> <iyz>0.0</iyz>
          <izz>0.01</izz>
        </inertia>
      </inertial>
      <visual name="rear_left_wheel_visual">
        <pose>-0.957138 0.625029 -0.025 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/wheel_back_left_link.stl</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="rear_left_wheel_collision">
        <pose>-0.957138 0.625029 -0.025 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/wheel_back_left_link.stl</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- Front Right Wheel -->
    <link name="front_right_wheel">
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.01</ixx> <ixy>0.0</ixy> <ixz>0.0</ixz>
          <iyy>0.01</iyy> <iyz>0.0</iyz>
          <izz>0.01</izz>
        </inertia>
      </inertial>
      <visual name="front_right_wheel_visual">
        <pose>0.554282 -0.625029 -0.025 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/wheel_front_right_link.stl</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="front_right_wheel_collision">
        <pose>0.554282 -0.625029 -0.025 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/wheel_front_right_link.stl</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- Rear Right Wheel -->
    <link name="rear_right_wheel">
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.01</ixx> <ixy>0.0</ixy> <ixz>0.0</ixz>
          <iyy>0.01</iyy> <iyz>0.0</iyz>
          <izz>0.01</izz>
        </inertia>
      </inertial>
      <visual name="rear_right_wheel_visual">
        <pose>-0.957138 -0.625029 -0.025 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/wheel_back_right_link.stl</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="rear_right_wheel_collision">
        <pose>-0.957138 -0.625029 -0.025 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/wheel_back_right_link.stl</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- Accessories -->
    <link name="accessories">
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.001</ixx> <ixy>0.0</ixy> <ixz>0.0</ixz>
          <iyy>0.001</iyy> <iyz>0.0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="accessories_visual">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/accessories_link.stl</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="accessories_collision">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/accessories_link.stl</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- Accessories1 -->
    <link name="accessories1">
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.001</ixx> <ixy>0.0</ixy> <ixz>0.0</ixz>
          <iyy>0.001</iyy> <iyz>0.0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="accessories1_visual">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/accessories1_link.stl</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="accessories1_collision">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/accessories1_link.stl</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- Board -->
    <link name="board">
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.002</ixx> <ixy>0.0</ixy> <ixz>0.0</ixz>
          <iyy>0.002</iyy> <iyz>0.0</iyz>
          <izz>0.002</izz>
        </inertia>
      </inertial>
      <visual name="board_visual">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/board_link.stl</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="board_collision">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/board_link.stl</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- LD19 LiDAR -->
    <link name="ld19">
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.001</ixx> <ixy>0.0</ixy> <ixz>0.0</ixz>
          <iyy>0.001</iyy> <iyz>0.0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="ld19_visual">
        <pose>0.2 0 0.3 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/LD19.stl</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="ld19_collision">
        <pose>0.2 0 0.3 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/LD19.stl</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
      </collision>
      <!-- LiDAR Sensor -->
      <!-- <sensor name="ld19_sensor" type="lidar">
        <pose>0.2 0 0.3 0 0 0</pose>
        <topic>/scan</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1.0</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>30.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
      </sensor> -->
    </link>

    <!-- OLED Screen -->
    <link name="oled_screen">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0005</ixx> <ixy>0.0</ixy> <ixz>0.0</ixz>
          <iyy>0.0005</iyy> <iyz>0.0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>
      <visual name="oled_screen_visual">
        <pose>0.1 0 0.2 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/oled_screen_link.stl</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="oled_screen_collision">
        <pose>0.1 0 0.2 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/oled_screen_link.stl</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- Top Shell -->
    <link name="top_shell">
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.02</ixx> <ixy>0.0</ixy> <ixz>0.0</ixz>
          <iyy>0.02</iyy> <iyz>0.0</iyz>
          <izz>0.02</izz>
        </inertia>
      </inertial>
      <visual name="top_shell_visual">
        <pose>0 0 0.3 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/top_shell_link.stl</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="top_shell_collision">
        <pose>0 0 0.3 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file:///home/prathmesh2931/rover_eysip/src/rover_sim/sdf/meshes/top_shell_link.stl</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- Joints for Wheels -->
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_left_wheel</child>
      <pose>0.554283 0.625029 -0.025 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_left_wheel</child>
      <pose>-0.0 0.0 -0.0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_right_wheel</child>
      <pose>0.554282 -0.625029 -0.025 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_right_wheel</child>
      <pose>-0.957138 -0.625029 -0.025 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <!-- Fixed Joints for Accessories and Sensors -->
    <joint name="accessories_joint" type="fixed">
      <parent>chassis</parent>
      <child>accessories</child>
      <pose>0 0 0.1 0 0 0</pose>
    </joint>
    <joint name="accessories1_joint" type="fixed">
      <parent>chassis</parent>
      <child>accessories1</child>
      <pose>0 0 0.15 0 0 0</pose>
    </joint>
    <joint name="board_joint" type="fixed">
      <parent>chassis</parent>
      <child>board</child>
      <pose>0 0 0.05 0 0 0</pose>
    </joint>
    <joint name="ld19_joint" type="fixed">
      <parent>chassis</parent>
      <child>ld19</child>
      <pose>0.2 0 0.3 0 0 0</pose>
    </joint>
    <joint name="oled_screen_joint" type="fixed">
      <parent>chassis</parent>
      <child>oled_screen</child>
      <pose>0.1 0 0.2 0 0 0</pose>
    </joint>
    <joint name="top_shell_joint" type="fixed">
      <parent>chassis</parent>
      <child>top_shell</child>
      <pose>0 0 0.3 0 0 0</pose>
    </joint>

    <!-- Differential Drive Plugin -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>1.25</wheel_separation>
      <wheel_radius>0.25</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/rover/cmd_vel</topic>
      <odom_topic>/rover/odometry</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>chassis</child_frame_id>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_linear_velocity>0.5</max_linear_velocity>
      <min_angular_velocity>-1.0</min_angular_velocity>
      <max_angular_velocity>1.0</max_angular_velocity>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <publish_odom_tf>true</publish_odom_tf>
      <max_torque>30.0</max_torque>
    </plugin>
  </model>
  </world>
</sdf>
